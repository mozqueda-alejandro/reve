<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="RevitAPI">
        <HintPath>..\..\..\..\..\..\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="RevitAPIUI">
        <HintPath>..\..\..\..\..\..\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
        <Private>False</Private>
      </Reference>
    </ItemGroup>

    <PropertyGroup>
        <RevitYear>2026</RevitYear>
    </PropertyGroup>

    <Target Name="CopyAddinManifest" BeforeTargets="BeforeBuild">
        <Copy SourceFiles="Reve.addin"
              DestinationFolder="$(ProgramData)\Autodesk\Revit\Addins\$(RevitYear)"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
