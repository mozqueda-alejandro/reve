<Window x:Class="Reve.UI.ConduitListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reve - Conduits"
        Width="600"
        Height="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Conduits}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding ConduitTypeName}" Width="*" />
                <DataGridTextColumn Header="Diameter (in)" Binding="{Binding DiameterInInches, StringFormat=F3}" Width="Auto" />
                <DataGridTextColumn Header="Length (ft)" Binding="{Binding LengthInFeet, StringFormat=F2}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   FontWeight="Bold"
                   Text="{Binding TotalLengthInFeet, StringFormat='Total length: {0:F2} ft'}" />
    </Grid>
</Window>
